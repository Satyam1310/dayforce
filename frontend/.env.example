# Copy to .env.local to override. Vite only exposes vars starting with VITE_.
# true = in-browser mock data, false = real backend.
# If not set: mock data in `npm run dev`, real backend in `npm run build` (deployments).
# VITE_USE_MOCK=true
# Base path of the real API (proxied to http://localhost:8000 in dev)
VITE_API_BASE_URL=/api
