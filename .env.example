DATABASE_URL=postgresql+psycopg://app:app@postgres:5432/timecards
# --- LLM (hosted open-weight model through an OpenAI-compatible API) ---
# Provider: openai_compatible | ollama | mock
LLM_PROVIDER=openai_compatible
# Groq's OpenAI-compatible endpoint (the client appends /chat/completions)
LLM_BASE_URL=https://api.groq.com/openai/v1
# Pick the exact model name from the provider's model list. Not hard-coded anywhere.
LLM_MODEL=<model name from the provider's model list>
# Put the real key ONLY in backend/.env (gitignored). Never commit it, never paste it in chat.
LLM_API_KEY=<your key, only in backend/.env, never commit>
# Offline option: LLM_PROVIDER=ollama, LLM_BASE_URL=http://ollama:11434/v1, LLM_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=20
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Relevance thresholds, one per retriever (different score scales)
RETRIEVAL_MIN_SCORE_MEMORY=0.35
RETRIEVAL_MIN_SCORE_PGVECTOR=0.57
# Optional: a plain RETRIEVAL_MIN_SCORE, if set, overrides BOTH of the above
# RETRIEVAL_MIN_SCORE=0.57
CONFIDENCE_ESCALATE_BELOW=0.5
LOG_LEVEL=INFO
# Mock provider only (LLM_PROVIDER=mock): ok | invalid_json | timeout | bad_citation | low_confidence
LLM_MOCK_MODE=ok
# Policy retriever: memory (default, no DB, used in CI) | pgvector (run `python -m app.ai.ingest` first)
RETRIEVER=memory
